{
  "name": "vitest-sonar-reporter",
  "version": "3.0.0",
  "description": "SonarQube reporter for Vitest",
  "keywords": [
    "sonar",
    "sonarqube",
    "vitest",
    "vitest-reporter"
  ],
  "homepage": "https://github.com/AriPerkkio/vitest-sonar-reporter",
  "bugs": "https://github.com/AriPerkkio/vitest-sonar-reporter",
  "license": "MIT",
  "author": "Ari Perkkiö <ari.perkkio@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AriPerkkio/vitest-sonar-reporter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": "./dist/index.js",
  "scripts": {
    "changelog": "npx conventional-changelog-cli -i CHANGELOG.md -p conventionalcommits -s -r 0",
    "prebuild": "rm -rf ./dist",
    "build": "tsc --project tsconfig.prod.json",
    "start": "vitest --update",
    "fmt": "oxfmt",
    "lint": "publint && oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "validate": "pnpm build && pnpm fmt --check && pnpm lint && pnpm typecheck && pnpm test run"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "publint": "^0.3.25",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "engines": {
    "node": "^12.20.0 || ^14.13.1 || >=16.0.0"
  },
  "packageManager": "pnpm@10.14.0"
}
